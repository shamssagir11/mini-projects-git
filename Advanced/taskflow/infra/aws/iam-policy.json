{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TaskFlowS3AttachmentsAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::taskflow-attachments-prod/*"
    },
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::taskflow-attachments-prod",
        "arn:aws:s3:::taskflow-attachments-prod/*"
      ],
      "Condition": {
        "Bool": { "aws:SecureTransport": "false" }
      }
    }
  ]
}
