{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyPublicReadWrite",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::taskflow-attachments-prod",
        "arn:aws:s3:::taskflow-attachments-prod/*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalAccount": "YOUR_AWS_ACCOUNT_ID"
        }
      }
    }
  ]
}
