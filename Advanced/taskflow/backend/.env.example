# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:Idanish@1234@localhost:5432/taskflow?schema=public"

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# AWS S3 (file attachments)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=taskflow-attachments-prod
# LOCAL DEV ONLY. In production (ECS/EC2), leave these unset and attach an IAM Role instead —
# see backend/src/config/s3.ts for details. NEVER commit real keys to git.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
